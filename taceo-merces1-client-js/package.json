{
  "name": "@taceo/merces1-client",
  "version": "1.0.1",
  "description": "Client for TACEO:Merces1",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/TaceoLabs/merces1-x402",
    "directory": "taceo-merces1-client-js"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.js",
  "type": "module",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "format": "prettier --write ."
  },
  "files": [
    "dist/**",
    "merces.json",
    "erc20.json",
    "client.wasm",
    "client.zkey"
  ],
  "keywords": [],
  "engines": {
    "node": ">=22"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.22.0",
      "onFail": "download"
    }
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "eslint": "^9.13.0",
    "globals": "^15.11.0",
    "prettier": "^3.3.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.12.0"
  },
  "dependencies": {
    "@noble/curves": "^2.2.0",
    "@noble/hashes": "^2.2.0",
    "@taceo/poseidon2": "^0.2.0",
    "@types/snarkjs": "^0.7.9",
    "snarkjs": "^0.7.6",
    "viem": "^2.46.3"
  }
}
